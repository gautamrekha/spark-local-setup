   "source": [
    "from pyspark.sql import SparkSession\n",
    "\n",
    "# 1️⃣ Start Spark session\n",
    "spark = SparkSession.builder.appName(\"QuickTest\").getOrCreate()\n",
    "\n",
    "# 2️⃣ Simple DataFrame\n",
    "df = spark.createDataFrame([(\"Alice\", 34), (\"Bob\", 45)], [\"name\", \"age\"])\n",
    "df.show()\n",
    "\n",
    "# 3️⃣ Stop Spark session\n",
    "spark.stop()\n"
   ]
  }
